# Auto detect text files and perform LF normalization
* text=auto

# Force these files to be CRLF
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Force these files to be LF
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files (these should not be modified by Git)
*.pcap binary
*.pcapng binary
*.rdp binary
*.etl binary
*.etl.gz binary
*.cap binary
*.dump binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
